# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Microsoft Foundry (Claude) -------------------------------------------
# Get both from the Azure AI Foundry portal for your Claude deployment.
FOUNDRY_API_KEY=your-foundry-api-key
FOUNDRY_API_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/anthropic/

# Exact model id. Never append a date suffix.
MODEL_ID=claude-opus-4-7

# --- App ------------------------------------------------------------------
APP_ENV=local
JWT_SECRET=change-me-to-a-long-random-string-for-local-only
DATABASE_URL=sqlite:///./data/poc.db

# --- Per-run budgets (see app/policy.py) ----------------------------------
MAX_TOOL_CALLS_PER_RUN=30
MAX_TOKENS_PER_RUN=150000
MAX_RUN_SECONDS=120
MAX_USD_PER_RUN=0.60
