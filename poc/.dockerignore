# Secrets -- never enter the build context, let alone a layer.
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Generated at container startup instead (see docker/entrypoint.sh) -- keeps
# the image from baking in a stale or oversized copy of the demo book.
backend/data/
data/
*.db
*.db-wal
*.db-shm
*.db.*.bak

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
backend/tests/

# Node -- reinstalled fresh in the frontend-build stage
frontend/node_modules/
frontend/dist/

# Everything not needed to build or run the image
.git/
.claude/
reports/
scripts/spike_foundry.py
scripts/evaluate.py
scripts/tool_smoke.py
scripts/verify_synthetic_data.py
*.md
evaluation.json

# OS
.DS_Store
Thumbs.db
